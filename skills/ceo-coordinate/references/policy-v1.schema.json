{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "effectiveAt": {
      "type": "string",
      "format": "date-time"
    },
    "active": {
      "type": "boolean"
    },
    "fixtureOnly": {
      "type": "boolean"
    },
    "executionEnabled": {
      "type": "boolean"
    },
    "ownerRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "agreement": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "reference",
        "revision"
      ],
      "additionalProperties": false
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "bindings": {
      "type": "object",
      "properties": {
        "linear": {
          "type": "object",
          "properties": {
            "workspaceRef": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "teamRef": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "workspaceRef",
            "teamRef"
          ],
          "additionalProperties": false
        },
        "github": {
          "type": "object",
          "properties": {
            "repositories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "repositories"
          ],
          "additionalProperties": false
        },
        "erpnext": {
          "type": "object",
          "properties": {
            "connectionRef": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "connectionRef"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "linear",
        "github",
        "erpnext"
      ],
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "properties": {
        "development": {
          "type": "object",
          "properties": {
            "environmentConfigId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "environmentConfigId"
          ],
          "additionalProperties": false
        },
        "operations": {
          "type": "object",
          "properties": {
            "environmentConfigId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "environmentConfigId"
          ],
          "additionalProperties": false
        },
        "pilot": {
          "type": "object",
          "properties": {
            "environmentConfigId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "environmentConfigId"
          ],
          "additionalProperties": false
        },
        "general": {
          "type": "object",
          "properties": {
            "environmentConfigId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "environmentConfigId"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "development": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          },
          "required": [
            "model",
            "effort"
          ],
          "additionalProperties": false
        },
        "boundedAdministrative": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          },
          "required": [
            "model",
            "effort"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          },
          "required": [
            "model",
            "effort"
          ],
          "additionalProperties": false
        },
        "visual": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            }
          },
          "required": [
            "model",
            "effort"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "properties": {
        "preferredMin": {
          "type": "integer",
          "minimum": 1
        },
        "preferredMax": {
          "type": "integer",
          "minimum": 1
        },
        "activeMax": {
          "type": "integer",
          "minimum": 1
        },
        "urgentIncidentMax": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "preferredMin",
        "preferredMax",
        "activeMax",
        "urgentIncidentMax"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "administrativeHours": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "lowSchoolActivityPreference": {
          "type": "boolean"
        }
      },
      "required": [
        "administrativeHours",
        "lowSchoolActivityPreference"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "restrictedWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weekdays": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                }
              },
              "start": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "weekdays",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "observationMinimumMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "restrictedWindows",
        "observationMinimumMinutes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "profileId",
    "revision",
    "effectiveAt",
    "active",
    "fixtureOnly",
    "executionEnabled",
    "ownerRef",
    "agreement",
    "timezone",
    "bindings",
    "routing",
    "models",
    "capacity",
    "selection",
    "release"
  ],
  "additionalProperties": false
}
